# =============================================================================
# CAG Interactive Gateway - Environment Configuration
# =============================================================================
#
# This file documents ALL environment variables used by the CAG system.
# Copy this file to .env for local development: cp .env.example .env
#
# IMPORTANT:
#   - NEVER commit .env files with real API keys to git
#   - .env and .env.production should be in .gitignore
#   - GCP production uses Terraform/workflow-injected variables
#
# =============================================================================


# =============================================================================
# ENVIRONMENT MODE
# =============================================================================
# Controls where data is stored and how services connect
#
# LOCAL DEVELOPMENT:
#   - DATA_BUCKET is EMPTY (no GCS sync)
#   - All data stored in ./data/ directory
#   - Services connect to localhost
#
# GCP PRODUCTION:
#   - DATA_BUCKET is set (enables GCS sync)
#   - Data synced to/from GCS bucket
#   - Services use GCP-native connections
# =============================================================================

# Leave EMPTY for local development, set for GCP production
# Example: DATA_BUCKET=cag-data-your-project-id
DATA_BUCKET=

# Local data directory (default: ./data for local, /app/data for Docker)
DATA_DIR=./data

# Environment identifier (dev, staging, prod)
APP_ENV=dev


# =============================================================================
# LLM PROVIDER CONFIGURATION
# =============================================================================
# Primary LLM for RAG chat and parsing pipeline
# Options: gemini (recommended for GCP), claude, openai

LLM_PROVIDER=gemini

# Model overrides (optional - defaults are used if not set)
# LLM_GEMINI_MODEL=gemini-2.5-flash
# LLM_CLAUDE_MODEL=claude-sonnet-4-20250514
# LLM_OPENAI_MODEL=gpt-4o-mini


# =============================================================================
# API KEYS
# =============================================================================
# Get these from respective provider dashboards
# NEVER commit real keys - use placeholders in .env.example

# Google AI / Vertex AI (REQUIRED for Gemini)
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# For Vertex AI (GCP production only)
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# VERTEX_AI_REGION=us-central1

# OpenAI (REQUIRED for embeddings if not using Vertex)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic (REQUIRED for Claude batch processing in Phase 10a)
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Cohere (REQUIRED for reranking)
# Get from: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your-cohere-api-key-here

# Voyage AI (OPTIONAL - for alternative embeddings)
# VOYAGE_API_KEY=your-voyage-api-key-here


# =============================================================================
# EMBEDDING CONFIGURATION
# =============================================================================
# Choose between OpenAI embeddings or Vertex AI embeddings (20x cheaper)

# Set to 'true' to use Vertex AI text-embedding-005 (recommended for GCP)
USE_VERTEX_EMBEDDINGS=false

# Set to 'true' for Vertex AI native integration (GCP production)
USE_VERTEX_AI=false


# =============================================================================
# VECTOR DATABASE (Qdrant)
# =============================================================================
# Option A: Local Qdrant (for development)
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Option B: Qdrant Cloud (for production)
# QDRANT_URL=https://your-cluster.cloud.qdrant.io
# QDRANT_API_KEY=your-qdrant-api-key


# =============================================================================
# ENTITY GRAPH DATABASE (PostgreSQL)
# =============================================================================
# Required for entity graph features (Phase 12)

# Local development (PostgreSQL running on host)
ENTITY_GRAPH_DSN=postgresql+psycopg://cag:cag_dev_pass@localhost:5433/cag_entity_graph

# Docker development (use host.docker.internal)
# ENTITY_GRAPH_DSN=postgresql+psycopg://cag:cag_dev_pass@host.docker.internal:5433/cag_entity_graph

# GCP production (Cloud SQL)
# ENTITY_GRAPH_DSN=postgresql+psycopg://user:pass@/cag_entity_graph?host=/cloudsql/project:region:instance


# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable/disable specific pipeline features

# RAG features
groundedness.enabled=True
agentic.enabled=True

# Batch processing
# USE_CLAUDE_BATCH=true  # Use Claude instead of Gemini for batch summaries


# =============================================================================
# API RATE LIMITING
# =============================================================================
# Format: "count/period" where period = second, minute, hour, day
# Protects LLM-hitting endpoints from abuse

RATE_LIMIT_CHAT=30/hour


# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
# PostHog analytics (optional)
VITE_PUBLIC_POSTHOG_KEY=your-posthog-key
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Access gate (for invite-only testing)
# Comma-separated access codes
# VITE_ACCESS_CODE=code-user1,code-user2

# Disable access gate for development
VITE_DISABLE_ACCESS_GATE=true


# =============================================================================
# PARSING PIPELINE OVERRIDES (Optional)
# =============================================================================
# Override parsing_config.yaml settings via environment variables
# Format: PARSING_{PHASE}_{SETTING}

# Example overrides:
# PARSING_TRIAGE_TEXT_THRESHOLD=200
# PARSING_LAYOUT_CONFIDENCE_THRESHOLD=0.7
# PARSING_INSTRUMENTATION_ENABLED=true


# =============================================================================
# DIRECTORY STRUCTURE (Reference)
# =============================================================================
# When running locally, the following directories are used:
#
# ./data/
# ├── raw/{tier}/                    # Downloaded PDFs
# ├── processed/
# │   ├── {tier}/*_chunks.json       # Assembled chunk files
# │   ├── ocred/*_ocred.pdf          # OCR'd PDFs
# │   └── manifest.json              # Processing manifest
# ├── batch_jobs/
# │   ├── jobs/                      # Job trackers
# │   ├── overviews/                 # LLM-extracted overviews
# │   ├── summaries/                 # Generated summaries
# │   ├── hierarchical/              # RAPTOR summaries
# │   └── visual_extraction/         # Visual extraction results
# ├── extraction_images/
# │   ├── tables/                    # Table screenshots
# │   └── charts/                    # Chart screenshots
# └── entity_graph/                  # Canonical entities
#
# ./logs/
# ├── traces/{tier}/                 # Trace instrumentation
# └── *.log                          # Pipeline logs
#
# When running on GCP, these sync to:
# gs://{DATA_BUCKET}/processed/
# gs://{DATA_BUCKET}/raw/
# gs://{DATA_BUCKET}/batch_jobs/
# gs://{DATA_BUCKET}/extraction_images/
# gs://{DATA_BUCKET}/traces/
# gs://{DATA_BUCKET}/logs/
