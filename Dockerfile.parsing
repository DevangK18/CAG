# =============================================================================
# CAG Parsing Pipeline Container
# =============================================================================
# This container includes all heavy ML dependencies for running the
# 10-phase parsing pipeline on Compute Engine.
#
# Build:
#   docker build -f Dockerfile.parsing -t cag-parsing .
#
# Run locally:
#   docker run -v ./data:/app/data -v ./manifest.xlsx:/app/manifest.xlsx \
#     cag-parsing manifest.xlsx
#
# On GCP (with GCS):
#   docker run -e DATA_BUCKET=cag-data-xxx cag-parsing manifest.xlsx
# =============================================================================

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies for OCR, PDF processing, and ML
RUN apt-get update && apt-get install -y --no-install-recommends \
    # OCR
    tesseract-ocr \
    tesseract-ocr-eng \
    # PDF utilities
    poppler-utils \
    ghostscript \
    # OpenCV dependencies
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    # Build tools for some Python packages
    gcc \
    g++ \
    # Utilities
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Install Poetry for dependency management
RUN pip install --no-cache-dir poetry

# Copy dependency files
COPY pyproject.toml poetry.lock ./

# Configure Poetry: don't create virtualenv, install to system Python
RUN poetry config virtualenvs.create false

# Install all dependencies including parsing group
RUN poetry install --with parsing --no-interaction --no-ansi --no-root

# Install additional GCS dependencies
RUN pip install --no-cache-dir google-cloud-storage

# Install PyTorch with CUDA support for GPU acceleration
# This adds CUDA runtime libraries (~2GB) enabling GPU passthrough via --gpus all
# Falls back gracefully to CPU if no GPU is available
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cu121

# Copy all source code (including parsing pipeline)
COPY src/ ./src/

# Copy configuration files
COPY parsing_config.yaml ./

# Set Python path
ENV PYTHONPATH=/app

# CRITICAL: Disable output buffering so logs appear in real-time
ENV PYTHONUNBUFFERED=1

# HuggingFace cache directory for model downloads
ENV HF_HOME=/app/.cache/huggingface
ENV TRANSFORMERS_CACHE=/app/.cache/huggingface

# Data directory (can be mounted or synced from GCS)
ENV DATA_DIR=/app/data

# Create all required data directories
RUN mkdir -p /app/data/{raw,processed}/{union,state,local_body} \
    && mkdir -p /app/data/processed/ocred \
    && mkdir -p /app/data/batch_jobs/{jobs,overviews,summaries,hierarchical,visual_extraction,enrichment,chart_extraction} \
    && mkdir -p /app/data/extraction_images/{tables,charts} \
    && mkdir -p /app/data/entity_graph \
    && mkdir -p /app/data/canonical \
    && mkdir -p /app/logs/traces/{union,state,local_body} \
    && mkdir -p /app/.cache/huggingface

# Pre-download Docling models during build (avoids runtime download hang)
# This initializes the DocumentConverter which triggers model download
RUN python -c "\
print('Pre-downloading Docling models (TableFormer ACCURATE mode)...'); \
import sys; sys.stdout.flush(); \
from docling.document_converter import DocumentConverter, PdfFormatOption; \
from docling.datamodel.pipeline_options import PdfPipelineOptions, TableFormerMode; \
from docling.datamodel.base_models import InputFormat; \
opts = PdfPipelineOptions(do_table_structure=True); \
opts.table_structure_options.mode = TableFormerMode.ACCURATE; \
print('Initializing DocumentConverter (downloads ~500MB models)...'); \
sys.stdout.flush(); \
converter = DocumentConverter(format_options={InputFormat.PDF: PdfFormatOption(pipeline_options=opts)}); \
print('✅ Docling models pre-downloaded and cached'); \
"

# Default entrypoint runs the parsing pipeline
ENTRYPOINT ["python", "-m", "src.parsing_pipeline.main"]

# Default command (can be overridden)
CMD ["--help"]
